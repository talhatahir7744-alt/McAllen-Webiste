# Environment variables the site reads. Set the real values in the Vercel project (Settings → Environment Variables,
# or `vercel env add NAME production|preview`); never commit values. Local development: copy to .env.local (ignored).

# Clearance & Floor Models page (/clearance, lib/clearance.ts): the listings sheet, published to the web as CSV
# (Google Sheets → File → Share → Publish to web → CSV). Columns in lib/clearance.ts. Missing or unreachable → the
# page shows its empty state.
CLEARANCE_URL=

# /api/clearance-request: the GoHighLevel webhook that receives a "request this item" submission. Server-side only
# (sensitive): the URL never reaches the browser or any file in this repository.
GHL_CLEARANCE_WEBHOOK_URL=
