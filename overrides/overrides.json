{
  "_comment": "Hand-provided section code and live widget embeds applied by scripts/convert.mjs. `rules` match a GoHighLevel custom-code element by substrings of its current HTML (so desktop + mobile copies are both replaced) and swap in `file`; {{custom_values.*}} merge tags are filled from `vars`.",
  "vars": {
    "custom_values.new_store_city_location": "McAllen",
    "custom_values.store_image_url": "https://assets.cdn.filesafe.space/ARD47WoZpqaZSQ9MSxLD/media/69a1d3acb617a750cec56a9b.jpg",
    "custom_values.5th_image": "https://assets.cdn.filesafe.space/BljrSmLCnm4gF9LpsTRZ/media/6a7577049a9c7792ea57899a.png"
  },
  "imageReplacements": {
    "_comment": "old media path -> new media path, applied to every reference (bare CDN URL, resize variants, payload). The new file and its r_320…r_1200 variants are added to the clone tree with `node scripts/image-variants.mjs <file> <mediaPath>`.",
    "BljrSmLCnm4gF9LpsTRZ/media/6a7577099a9c7792ea578a2c.jpeg": "ARD47WoZpqaZSQ9MSxLD/media/69a1d3acb617a750cec56a9b.jpg"
  },
  "imageAlt": {
    "_comment": "alt text for client images that carry none, matched by media id; translated through overrides/i18n/es.extra.json",
    "69a1d3acb617a750cec56a9b": "Snooze Mattress + Wellness McAllen storefront",
    "6a7577099a9c7792ea578a2c": "Snooze Mattress + Wellness McAllen storefront"
  },
  "rules": [
    {
      "name": "dream-map-timeline",
      "match": [
        "pm-section",
        "Personalized Sleep Map Profile"
      ],
      "file": "dream-map-timeline.html"
    },
    {
      "name": "store-experience-timeline",
      "match": [
        "pm-section",
        "Apply for Financing In-Store"
      ],
      "file": "store-experience-timeline.html"
    },
    {
      "name": "our-promise-guarantee",
      "match": [
        "guar-section",
        "We Stand Behind"
      ],
      "file": "our-promise-guarantee.html"
    },
    {
      "name": "logo-marquee",
      "match": [
        "ENDLESS LOGO MARQUEE"
      ],
      "file": "logo-marquee.html"
    },
    {
      "name": "trust-ticker",
      "match": [
        "ghl-trust-ticker",
        "Price Match Promise"
      ],
      "file": "trust-ticker.html"
    },
    {
      "name": "logo-marquee-mobile",
      "match": [
        "custom-brand-slider"
      ],
      "file": "logo-marquee.html",
      "_comment": "the client's phone brand slider squeezed a 14999px sprite into the viewport (logos ~4x compressed); the seamless marquee replaces it on phones too"
    },
    {
      "name": "remove-giveaway-popup",
      "match": [
        "snzModal"
      ],
      "file": "empty.html",
      "_comment": "the 'Win a Free Cooling Pillow' popup + red 'Enter to Win' ticker (one custom-code element on the home pages) is removed; the emptied element is hidden by overrides/site.css"
    }
  ],
  "widgets": {
    "form": {
      "file": "widgets/form.html",
      "formId": "0BTnYKylVR6OcWJug3r8",
      "defaultFormId": "0BTnYKylVR6OcWJug3r8",
      "formName": "Optin",
      "_comment": "formId (McAllen) overrides the form id carried by every clone element; defaultFormId is the fallback for elements without one"
    },
    "calendar": {
      "file": "widgets/calendar.html",
      "calendarId": "lrAns7Z8j3vEJW3DC0Yr",
      "defaultCalendarId": "lrAns7Z8j3vEJW3DC0Yr"
    },
    "reviews": {
      "file": "widgets/reviews.html",
      "locationId": "ARD47WoZpqaZSQ9MSxLD",
      "widgetId": "67f5847f79c4ab793baf0087"
    }
  },
  "removeElements": [
    "section-n2EJ48xJKc",
    "section-EZ3DGo6-8h",
    "section-ghjYZIxTU2",
    "section-zTxb2Wa9Nv"
  ],
  "site": {
    "phone": "(956) 586-5646",
    "phoneHref": "tel:+19565865646",
    "logoUrl": "https://images.leadconnectorhq.com/image/f_webp/q_80/r_1200/u_https://assets.cdn.filesafe.space/qR8peonBlnjGI3ZuLHQP/media/8d16458d-661d-4d16-bec0-14dea766bf45.webp",
    "logoAlt": "Snooze Mattress + Wellness",
    "featureImageUrl": "https://images.leadconnectorhq.com/image/f_webp/q_80/r_640/u_https://assets.cdn.filesafe.space/ARD47WoZpqaZSQ9MSxLD/media/695fbfed-24ba-4132-b604-2e6042bbb83f.jpeg"
